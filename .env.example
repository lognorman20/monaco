# Local development only. Copy to `.env` and adjust if needed.
# Never put production Supabase URLs or secrets in this repo.

# Docker Compose Postgres (default host port 54322 avoids local Postgres on 5432)
POSTGRES_USER=monaco
POSTGRES_PASSWORD=monaco
POSTGRES_DB=monaco
POSTGRES_PORT=54322

# Optional: this machine's slim iOS Simulator UUID (not a secret; `simctl create` mints a new one).
# Used by just build/reset mobile and scripts/stop-mobile.sh. Also export in the shell for ios-sim.
# SIMSLIM_UDID=

# Go API reads this. Must point at localhost compose, not cloud Supabase.
# Tests auto-use sibling DB `{POSTGRES_DB}_test` (monaco_test). Do not set a second URL.
DATABASE_URL=postgres://monaco:monaco@localhost:54322/monaco?sslmode=disable

# Privy (M1 auth). Backend uses app id + secret; iOS uses app id + client id.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Solana fee payer for deposit sweeps and Jupiter txs (M2+). Base58 secret key — NOT a JSON [1,2,...] array.
# Must hold >0.001 SOL on mainnet; API boot fails if balance is too low. Print pubkey:
#   dotenvx run -f .env.local -- go run ./apps/backend/cmd/print-relayer-pubkey
# RELAYER_PRIVATE_KEY=
# Server-side wallet signing (M2 sweeps). Private key from Privy dashboard > Authorization keys.
# PRIVY_AUTHORIZATION_PRIVATE_KEY=wallet-auth:...
# Public quorum id for the same key — added as additional_signer on new member wallets.
# PRIVY_AUTHORIZATION_KEY_ID=
# iOS app client id from Privy dashboard > App Settings > Clients (bundle: com.monaco.app)
PRIVY_APP_CLIENT_ID=
# Legacy alias some local .env.local files use instead of PRIVY_APP_CLIENT_ID (mobile accepts either)
# PRIVY_AUTH_ID=

# Mobile login method flags (default on). Email uses Privy OTP, not password fields (M1-T11 UI).
PRIVY_SMS_LOGIN_ENABLED=true
PRIVY_EMAIL_LOGIN_ENABLED=true

# Supabase Storage (dev project monaco-dev). Backend upload only — mobile calls Go API, not Supabase.
# Dashboard: https://supabase.com/dashboard/project/komoccjaeypsrgocrnht
# SUPABASE_URL=https://<dev-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Pyth Hermes (M4+ marked pot, asset charts). Create a key at https://pyth.network/price-feeds/pyth-core
# PYTH_API_KEY=
# Optional override; default is the post-upgrade host https://pyth.dourolabs.app/hermes
# PYTH_HERMES_BASE_URL=
# Equity xStock marks (AAPLx, etc.) need equity feed grants on the key in Pyth Terminal.
# A valid key that only covers crypto returns 403 "Not entitled" for equity price updates.

# Jupiter Price API (catalog/popular display prices — not Swap API v2). Optional; the
# API serves unauthenticated requests at a lower rate limit. Get a key at https://portal.jup.ag
# JUPITER_API_KEY=

# Platform (all optional).
# LOG_FILE: append every log line as JSON to this path (stderr keeps a copy). Unset = text on
# stderr only, which dies with the terminal. Rotate with logrotate copytruncate.
# LOG_FILE=/var/log/monaco/api.log
# CORS_ALLOWED_ORIGINS: comma-separated browser origins allowed to call the API. Unset = none
# (the iOS app sends no Origin header and is unaffected). "*" is never honored.
# CORS_ALLOWED_ORIGINS=https://app.example.com
# TRUST_PROXY_HEADERS=true keys per-IP rate limits on X-Forwarded-For. Only behind a proxy
# that overwrites the header.
# TRUST_PROXY_HEADERS=

# Treasury swap venue: jupiter (default) or flash (Definitive Flash, https://flash.definitive.fi/docs).
# Flash needs an integrator key: app.definitive.fi > More > Flash > Create Flash Key.
# The first Flash trade of a token also lands a one-time relayer-paid setup tx (token account + SPL delegation).
# SWAP_PROVIDER=jupiter
# FLASH_API_KEY=
# Slippage bound for Flash market orders as a decimal (default 0.01 = 1%, max 0.05).
# FLASH_MAX_SLIPPAGE=0.01

# Manual (Privy dashboard): Login Methods > enable SMS and Email before testing auth.
# Email auth sends a one-time passcode to the inbox; enable both methods for M1 test accounts.

# Demo data (#153): enable POST /v1/dev/faker (loopback + local DB only). Off by default (404).
# FAKER_ENABLED=1
