# Local development only. Copy to `.env` and adjust if needed.
# Never put production Supabase URLs or secrets in this repo.

# Docker Compose Postgres (default host port 54322 avoids local Postgres on 5432)
POSTGRES_USER=monaco
POSTGRES_PASSWORD=monaco
POSTGRES_DB=monaco
POSTGRES_PORT=54322

# Optional: this machine's slim iOS Simulator UUID (not a secret; `simctl create` mints a new one).
# Used by just build/reset mobile and scripts/stop-mobile.sh. Also export in the shell for ios-sim.
# SIMSLIM_UDID=

# Go API reads this. Must point at localhost compose, not cloud Supabase.
# Tests auto-use sibling DB `{POSTGRES_DB}_test` (monaco_test). Do not set a second URL.
DATABASE_URL=postgres://monaco:monaco@localhost:54322/monaco?sslmode=disable

# Dynamic (M6 auth). Backend verifies JWTs; iOS uses DYNAMIC_ENVIRONMENT_ID in xcconfig.
DYNAMIC_ENVIRONMENT_ID=
# Signer sidecar (M6). Go uses SIGNER_URL + SIGNER_SHARED_SECRET; Node signer uses DYNAMIC_API_TOKEN and DYNAMIC_WALLET_PASSWORD.
# SIGNER_URL=http://127.0.0.1:8081
SIGNER_SHARED_SECRET=
WALLET_SHARES_KEY=
DYNAMIC_API_TOKEN=
DYNAMIC_WALLET_PASSWORD=

# Base relayer EOA (0x + 64 hex). Must hold ≥0.002 ETH on Base; API boot checks balance.
#   dotenvx run -f .env.local -- go run ./apps/backend/cmd/print-relayer-pubkey
# RELAYER_PRIVATE_KEY=
# Base JSON-RPC. Public https://mainnet.base.org rate-limits and stalls every screen.
# Use a keyed Alchemy / QuickNode / Coinbase Developer Platform Base URL.
# BASE_RPC_URL=https://mainnet.base.org
# KYBER_CLIENT_ID=monaco

# Mobile login method flags (default on).
AUTH_SMS_LOGIN_ENABLED=true
AUTH_EMAIL_LOGIN_ENABLED=true

# Supabase Storage (dev project monaco-dev). Backend upload only — mobile calls Go API, not Supabase.
# Dashboard: https://supabase.com/dashboard/project/komoccjaeypsrgocrnht
# SUPABASE_URL=https://<dev-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Pyth: display data on the stock screens (charts, stats grid, day change, the equity
# reference line). Never NAV: pot marks and hero prices are Chainlink.
# Create a key at https://pyth.network/price-feeds/pyth-core
# PYTH_API_KEY=
# Optional override; default is https://hermes.pyth.network
# PYTH_HERMES_BASE_URL=
# A valid key that only covers crypto returns 403 "Not entitled" for equity price updates.
#
# Pyth Benchmarks serves a whole chart range as OHLC in one call and needs no key, so
# charts and the stats grid keep working on a crypto-only key and with PYTH_API_KEY
# unset. Without a key you lose the equity reference line on the stock-vs-token card
# and the per-sample Hermes fallback when Benchmarks is down.
# Optional override; default is https://benchmarks.pyth.network
# PYTH_BENCHMARKS_BASE_URL=

# Manual (Dynamic dashboard): enable Email + SMS OTP, EVM/Base, server wallets; disable embedded client wallets.
# CORS origin https://monaco.app. iOS deeplink monaco://. SMS OTP also needs a dashboard SMS provider.

# Demo data (#153): enable POST /v1/dev/faker (loopback + local DB only). Off by default (404).
# FAKER_ENABLED=1
