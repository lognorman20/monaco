#!/usr/bin/env bash
# Monaco iOS sim launch with Dynamic env from dotenvx .env.local.
# Prefers SimSlim gold when SIMSLIM_UDID exists and simslim is ready.
# Otherwise warns and boots a stock Xcode simulator. Does not require ~/.local/bin/ios-sim.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

if [[ "${MONACO_DYNAMIC_ENV:-}" != "1" ]]; then
  exec "$repo_root/scripts/with-ios-dynamic-env.sh" "$0" "$@"
fi

bundle_id="com.monaco.app"
udid="$(./scripts/resolve-ios-sim.sh)"

if command -v simslim >/dev/null 2>&1 && [[ -n "${SIMSLIM_UDID:-}" && "$udid" == "$SIMSLIM_UDID" ]]; then
  profile="${SIMSLIM_PROFILE:-}"
  if [[ -z "$profile" && -f "${HOME}/.config/simslim/base-slim.json" ]]; then
    profile="${HOME}/.config/simslim/base-slim.json"
  fi
  if [[ -n "$profile" ]]; then
    simslim verify "$udid" --profile "$profile" >/dev/null 2>&1 \
      || simslim on "$udid" --profile "$profile" >/dev/null 2>&1 \
      || echo "warning: simslim on failed. continuing with a stock boot." >&2
  fi
fi

open -a Simulator >/dev/null 2>&1 || true

_ios_clipboard_bridge() {
  local cmd="$1"
  if command -v ios-sim-clipboard-bridge >/dev/null 2>&1; then
    ios-sim-clipboard-bridge "$cmd" >/dev/null 2>&1 || true
  elif [[ -x "${HOME}/.local/bin/ios-sim-clipboard-bridge" ]]; then
    "${HOME}/.local/bin/ios-sim-clipboard-bridge" "$cmd" >/dev/null 2>&1 || true
  fi
}
_ios_clipboard_bridge start

# Ad-hoc sign the sim build (see docs/how-to/local-simulator.md#signing) so the Dynamic
# session's keychain entry survives relaunch/reinstall instead of being dropped by an
# unsigned build.
xcodebuild -project apps/mobile/Monaco.xcodeproj -scheme Monaco \
  -destination "platform=iOS Simulator,id=${udid}" \
  -configuration Debug \
  CODE_SIGN_IDENTITY="-" CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=YES \
  build

app_path=""
newest=0
shopt -s nullglob
for candidate in "${HOME}/Library/Developer/Xcode/DerivedData"/Monaco-*/Build/Products/Debug-iphonesimulator/Monaco.app; do
  mt="$(stat -f %m "$candidate" 2>/dev/null || echo 0)"
  if [[ "$mt" -gt "$newest" ]]; then
    newest="$mt"
    app_path="$candidate"
  fi
done
shopt -u nullglob

if [[ ! -d "$app_path" ]]; then
  echo "error: built app not found at ${app_path}" >&2
  exit 1
fi

xcrun simctl boot "$udid" >/dev/null 2>&1 || true
xcrun simctl bootstatus "$udid" -b
xcrun simctl install "$udid" "$app_path"
xcrun simctl launch "$udid" "$bundle_id"
echo "launched ${bundle_id} on ${udid}"
