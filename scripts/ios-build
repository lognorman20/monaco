#!/usr/bin/env bash
# Monaco iOS compile for gold sim. Generates Privy xcconfig from .env.local first.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

./scripts/ensure-ios-privy-config.sh generate

global_ios_build="$(command -v ios-build || true)"
if [[ -z "$global_ios_build" || "$global_ios_build" == "$repo_root/scripts/ios-build" ]]; then
  global_ios_build="${HOME}/.local/bin/ios-build"
fi
if [[ ! -x "$global_ios_build" ]]; then
  echo "error: ios-build not found (~/.local/bin). Use: just build mobile" >&2
  exit 1
fi

cd apps/mobile
exec "$global_ios_build" "$@"
