#!/usr/bin/env bash
# Monaco iOS compile with Privy xcconfig. Uses SimSlim gold when ready, else stock sim.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

./scripts/ensure-ios-privy-config.sh generate
udid="$(./scripts/resolve-ios-sim.sh)"

xcodebuild -project apps/mobile/Monaco.xcodeproj -scheme Monaco \
  -destination "platform=iOS Simulator,id=${udid}" \
  -configuration Debug \
  build
